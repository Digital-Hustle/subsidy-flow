{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:subsidy:events:docproc.document.v1:DocumentFailed",
  "title": "DocumentFailed",
  "description": "docproc: разбор не удался после всех попыток. Это схема payload; конверт — envelope.schema.json.",
  "type": "object",
  "required": [
    "fileId",
    "packageId",
    "version",
    "reason"
  ],
  "properties": {
    "fileId": {
      "type": "string",
      "format": "uuid"
    },
    "packageId": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "reason": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
