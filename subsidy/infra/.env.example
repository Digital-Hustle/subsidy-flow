# Скопируйте в .env и заполните (scripts/gen-env.sh генерирует случайные значения). Никогда не коммитьте .env.
# Формат для новых переменных: NAME=...  (+ compose, CI и документация в том же PR)

# --- PostgreSQL (одна БД и роль на сервис) ---
POSTGRES_SUPERUSER_PASSWORD=...
PACKAGE_DB_PASSWORD=...
DOCPROC_DB_PASSWORD=...
RULES_DB_PASSWORD=...
ASSISTANT_DB_PASSWORD=...
# prod — программы кейса (Инновационный проект, Обустройство пляжа, Модернизация производства) создаются всегда;
# prod,demo — дополнительно демо-данные
LIQUIBASE_CONTEXTS=prod,demo

# --- Kafka (KRaft, один брокер, внутри сети без порта наружу) ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLUSTER_ID=...

# --- Keycloak (OIDC, realm subsidy) ---
KC_HOSTNAME=...
KC_BOOTSTRAP_ADMIN_USERNAME=...
KC_BOOTSTRAP_ADMIN_PASSWORD=...
KC_DB_PASSWORD=...
OIDC_ISSUER_URI=...
KC_SVC_PACKAGE_SECRET=...
KC_SVC_DOCPROC_SECRET=...
KC_SVC_RULES_SECRET=...
KC_SVC_ASSISTANT_SECRET=...
KC_DEMO_SPECIALIST_PASSWORD=...
KC_DEMO_SENIOR_PASSWORD=...
KC_DEMO_AUDITOR_PASSWORD=...

# --- Приём файлов (package) ---
# AES-256-GCM, base64 32 байта (gen-env.sh)
FILES_ENCRYPTION_KEY=...
UPLOAD_MAX_MB=30
UPLOAD_MAX_PAGES=60
UPLOAD_MAX_FILES=60
# ZIP: лимит распаковки и вложенности (защита от zip-бомб)
ZIP_MAX_UNPACKED_MB=300
ZIP_MAX_ENTRIES=100
IMAGE_MIN_PX=600

# --- Разбор (docproc, ocr) ---
PACKAGE_URL=http://package:8081
OCR_URL=http://ocr:8000
DOCPROC_WORKERS=4
JOB_LEASE=2m
JOB_MAX_ATTEMPTS=5
CLASSIFY_MIN_CONFIDENCE=0.6
FIELD_REVIEW_THRESHOLD=0.8
VISION_FALLBACK_ENABLED=false
# DP-14: OCR-страница со средней уверенностью ниже порога (0..1) при включённом vision уходит модели и картинкой
VISION_OCR_MIN_CONF=0.6
OCR_LANGS=rus+eng
OCR_MIN_CONFIDENCE=55

# --- Правила (rules) ---
DOCPROC_URL=http://docproc:8082
RULES_URL=http://rules:8083
ASSISTANT_URL=http://assistant:8084
# версия чек-листа и параметров программы по умолчанию (docs/RULES-CATALOG.md)
DEFAULT_PROGRAM=INNOVATION
EXPIRING_DAYS=30

# --- LLM (libs/llm, используется docproc и assistant) ---
# Локально: LLM_PROVIDER=ollama + `docker compose --profile llm-local up -d`.
# По API (любой OpenAI-совместимый): LLM_PROVIDER=openai, LLM_BASE_URL=https://<провайдер>/v1,
#   LLM_MODEL / LLM_VISION_MODEL — id из GET /v1/models, LLM_API_KEY — ключ; профиль llm-local не нужен.
#   LLM_JSON_MODE: json_schema (строгий, если провайдер умеет) | json_object (почти все) | none.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=qwen3:8b
LLM_VISION_MODEL=qwen2.5vl:7b
LLM_API_KEY=...
LLM_JSON_MODE=json_schema
LLM_TIMEOUT_SECONDS=60
LLM_MAX_CONCURRENCY=2
GIGACHAT_AUTH_KEY=...
GIGACHAT_SCOPE=GIGACHAT_API_PERS
ASSISTANT_ENABLED=true

# --- Вход сотрудников по коду из письма (package, ADR-023) ---
# demo — демо-стенд: тестовые сотрудники, код 000000 и код в ответе API; prod — боевой режим
STAND_MODE=prod
# ES256 (gen-env.sh): подпись токенов сессий сотрудников
STAFF_TOKEN_SIGNING_KEY=...
# соль для хранения кодов из писем
STAFF_CODE_PEPPER=...
# почта первого старшего специалиста (создаётся при старте package), можно оставить пустым
STAFF_BOOTSTRAP_EMAIL=
STAFF_CODE_MINUTES=10
STAFF_RESEND_SECONDS=60
STAFF_SESSION_HOURS=12
STAFF_ACCESS_MINUTES=5
# писать коды входа в лог package (только для отладки демо-стенда)
STAFF_LOG_CODES=false
# Почта: общий ящик всех кейсов. MAIL_FROM и SMTP_* берутся из этого файла (mail.env.example),
# в .env их класть не нужно — см. корневой MAIL.md.
MAIL_ENV_FILE=./mail.env

# --- Прочее ---
PUBLIC_HOST=...
# За общим edge сервера (edge/README.md): CADDY_SCHEME=http://, HTTP_BIND=127.0.0.1:8280, HTTPS_BIND=127.0.0.1:8643,
# PUBLIC_HOST/KC_HOSTNAME=subsidy.<домен>, OIDC_ISSUER_URI=https://subsidy.<домен>/auth/realms/subsidy. Без них — сам на 80/443.
CADDY_SCHEME=
HTTP_BIND=80
HTTPS_BIND=443
IMAGE_TAG=latest
OTLP_ENDPOINT=http://jaeger:4318/v1/traces
SITE_ZONE=Europe/Moscow
