# Общий почтовый ящик всех кейсов хакатона (корневой MAIL.md).
# Скопируйте в mail.env (или положите рядом со стендом и укажите MAIL_ENV_FILE=/путь/mail.env в .env).
# Файл не коммитится: в нём пароль ящика.
MAIL_FROM=no-reply@digital-hustle.ru
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=no-reply@digital-hustle.ru
SMTP_PASSWORD=
# smtps — SSL на 465; для STARTTLS на 587: SMTP_PROTOCOL=smtp, SMTP_PORT=587, SMTP_STARTTLS=true
SMTP_PROTOCOL=smtps
SMTP_STARTTLS=false
