  "users": [
    {
      "username": "specialist",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Анна",
      "lastName": "Смирнова",
      "email": "specialist@subsidy.local",
      "credentials": [
        {
          "type": "password",
          "value": "${KC_DEMO_SPECIALIST_PASSWORD}",
