    {
      "username": "senior",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Игорь",
      "lastName": "Волков",
      "email": "senior@subsidy.local",
      "credentials": [
        {
          "type": "password",
          "value": "${KC_DEMO_SENIOR_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
