          "config": {
            "included.custom.audience": "package",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "svc-aud-docproc",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "docproc",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "svc-aud-assistant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "assistant",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "svc-assistant",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "secret": "${KC_SVC_ASSISTANT_SECRET}",
      "protocolMappers": [
        {
          "name": "svc-aud-package",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "package",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "svc-aud-docproc",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "docproc",
