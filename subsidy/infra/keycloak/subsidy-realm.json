          }
        },
        {
          "name": "svc-aud-rules",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "rules",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "svc-aud-assistant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "assistant",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "svc-aud-ocr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "ocr",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "svc-rules",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "secret": "${KC_SVC_RULES_SECRET}",
      "protocolMappers": [
        {
          "name": "svc-aud-package",
          "protocol": "openid-connect",
